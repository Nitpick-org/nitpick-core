# Copier en .env et remplir. Ne jamais commiter .env.
# Les agents ne doivent jamais lire ce fichier ni afficher son contenu.

# App
APP_URL=http://localhost:3000
DEMO_URL=
DEMO_MODE=mock          # mock | live
DEMO_SEED=1

# Données
DATABASE_URL=

# IA (une seule clé suffit)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Auth (seulement si vous ne pouvez pas l'éviter)
AUTH_SECRET=

# Sponsors / APIs externes (ajouter au besoin)
SPONSOR_API_KEY=
