# Copy to .env and fill in. Never commit .env.
# Agents must never read this file or print its contents.

# App
APP_URL=http://localhost:3000
DEMO_URL=
DEMO_MODE=mock          # mock | live
DEMO_SEED=1

# Data
DATABASE_URL=

# AI (one key is enough)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Auth (only if you cannot avoid it)
AUTH_SECRET=

# Sponsors / external APIs (add as needed)
SPONSOR_API_KEY=
