# Copy to .env and fill in. Never commit .env.
#
# Nothing here is read by the app at runtime: Nitpick stores the provider key and the forge
# token through its Settings screen (FileSettingsStore, ~/.nitpick/settings.json).
# These variables only opt the real-provider test into a live call; without them
# shared/src/jvmTest/kotlin/dev/nitpick/app/review/RealReviewCallTest.kt is skipped.

# One provider is enough: set its key, optionally its model.
APP_ANTHROPIC_API_KEY=
# APP_ANTHROPIC_MODEL=
APP_OPENAI_API_KEY=
# APP_OPENAI_MODEL=
APP_GOOGLE_API_KEY=
# APP_GOOGLE_MODEL=

# Ollama needs no key: set the model name to run the local provider.
APP_OLLAMA_MODEL=

# Ktor review-sharing server. Defaults to 127.0.0.1; set 0.0.0.0 only for a deliberate
# LAN demo (the phone normally reaches it through `adb reverse tcp:8080 tcp:8080`).
NITPICK_BIND=
