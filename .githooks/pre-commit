#!/usr/bin/env bash
# Blocks the commit when the feedback loops fail (humans and agents alike).
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Never commit secrets, even by accident. This check also runs during scaffolding.
STAGED_ENV="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)\.env($|\.)' \
  | grep -v '\.env\.example$' \
  || true)"
if [ -n "$STAGED_ENV" ]; then
  echo "❌ A .env file is staged (only .env.example is allowed):"
  printf '%s\n' "$STAGED_ENV"
  echo "   Unstage it: git restore --staged <file>"
  exit 1
fi

# During the scaffolding phase there is nothing else to check yet.
if [ ! -x gradlew ]; then
  echo "⚠️  No gradlew yet: skipping checks (scaffolding phase)."
  exit 0
fi

BRANCH="$(git branch --show-current 2>/dev/null || true)"
if [ "$BRANCH" = "main" ] && git rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "⚠️  Direct commit on main. Team rule: main only through a PR."
fi

# git exports GIT_DIR and GIT_INDEX_FILE to hooks; in-process JGit tests would read them and
# write their fixture clones into this repository's own index.
exec env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX ./scripts/check.sh
