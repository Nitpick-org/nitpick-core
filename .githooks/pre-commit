#!/usr/bin/env bash
# Blocks the commit when the feedback loops fail (humans and agents alike).
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# During the scaffolding phase there is nothing to check yet.
if [ ! -f package.json ]; then
  echo "⚠️  No package.json yet: skipping checks (scaffolding phase)."
  exit 0
fi

# Never commit secrets, even by accident.
if git diff --cached --name-only --diff-filter=ACM | grep -Eq '(^|/)\.env($|\.)'; then
  echo "❌ A .env file is staged. Unstage it: git restore --staged .env"
  exit 1
fi

BRANCH="$(git branch --show-current 2>/dev/null || true)"
if [ "$BRANCH" = "main" ] && git rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "⚠️  Direct commit on main. Team rule: main only through a PR."
fi

exec ./scripts/check.sh
